{
  "version": "1.1.0",
  "rules": [
    {
      "id": "VC-ITEM-QUANTITY-001",
      "description": "Order item quantity must be a positive integer up to 100.",
      "field": "quantity",
      "dataType": "number",
      "required": true,
      "min": 1,
      "max": 100
    },
    {
      "id": "VC-ITEM-PRICE-002",
      "description": "Item price must be non-negative.",
      "field": "price",
      "dataType": "number",
      "required": true,
      "min": 0
    },
    {
      "id": "VC-EMAIL-FORMAT-003",
      "description": "Email addresses are trimmed before storage and must be a valid email.",
      "field": "email",
      "dataType": "string",
      "required": true,
      "format": "email",
      "normalization": ["trim"]
    },
    {
      "id": "VC-USER-ROLE-004",
      "description": "User role must be one of admin, user or guest.",
      "field": "role",
      "dataType": "string",
      "required": true,
      "allowedValues": ["admin", "user", "guest"]
    },
    {
      "id": "VC-SHIP-WEIGHT-005",
      "description": "Shipment weight in kilograms must be non-negative.",
      "field": "weightKg",
      "dataType": "number",
      "required": true,
      "min": 0
    },
    {
      "id": "VC-ORDER-QTY-006",
      "description": "Order quantity for the usage-tracing fixture: must be a positive integer up to 100.",
      "field": "quantity",
      "dataType": "number",
      "required": true,
      "min": 1,
      "max": 100
    },
    {
      "id": "VC-ORDER-NOTE-007",
      "description": "Order note is trimmed free text.",
      "field": "note",
      "dataType": "string",
      "required": true,
      "normalization": ["trim"]
    },
    {
      "id": "VC-ORDER-COMMENT-008",
      "description": "Order comment is trimmed free text.",
      "field": "comment",
      "dataType": "string",
      "required": true,
      "normalization": ["trim"]
    },
    {
      "id": "VC-STOCK-COUNT-009",
      "description": "Stock count must be a non-negative integer.",
      "field": "stock",
      "dataType": "number",
      "required": true,
      "integer": true,
      "min": 0
    },
    {
      "id": "VC-DISCOUNT-PERCENT-010",
      "description": "Discount percentage must be between 0 and 100 inclusive.",
      "field": "discount",
      "dataType": "number",
      "required": true,
      "min": 0,
      "max": 100
    },
    {
      "id": "VC-RATING-SCORE-011",
      "description": "Rating score must be zero or a positive number (0 is a valid, unrated state).",
      "field": "rating",
      "dataType": "number",
      "required": true,
      "min": 0
    },
    {
      "id": "VC-WEBSITE-URL-012",
      "description": "Website must be a valid URL.",
      "field": "website",
      "dataType": "string",
      "required": true,
      "format": "url"
    },
    {
      "id": "VC-AGE-CHECK-013",
      "description": "Age must be a non-negative number.",
      "field": "age",
      "dataType": "number",
      "required": true,
      "min": 0
    },
    {
      "id": "VC-COUPON-CAP-014",
      "description": "Coupon value must be between 0 and 50 inclusive.",
      "field": "coupon",
      "dataType": "number",
      "required": true,
      "min": 0,
      "max": 50
    },
    {
      "id": "VC-IMPOSSIBLE-RANGE-015",
      "description": "Placeholder business rule for the impossible-range unresolved test.",
      "field": "impossible",
      "dataType": "number",
      "required": true,
      "min": 10,
      "max": 5
    },
    {
      "id": "VC-CONTACT-HANDLE-016",
      "description": "Contact handle must be a valid email.",
      "field": "contact",
      "dataType": "string",
      "required": true,
      "format": "email"
    },
    {
      "id": "VC-DATAFLOW-SAME-FUNCTION-017",
      "description": "Order item name for the dataflow-tracing fixture.",
      "field": "name",
      "dataType": "string",
      "required": true
    },
    {
      "id": "VC-DATAFLOW-ONE-HOP-018",
      "description": "Order note for the dataflow-tracing fixture.",
      "field": "note",
      "dataType": "string",
      "required": true
    },
    {
      "id": "VC-DATAFLOW-UNRESOLVED-019",
      "description": "Order tag for the dataflow-tracing fixture.",
      "field": "tag",
      "dataType": "string",
      "required": true
    },
    {
      "id": "VC-LAYER-ATTRIBUTED-021",
      "description": "Backend attribution confirmed via request-fed dataflow evidence.",
      "field": "name",
      "dataType": "string",
      "required": true,
      "layers": ["backend"]
    },
    {
      "id": "VC-LAYER-UNATTRIBUTED-022",
      "description": "Claims the backend layer, but the implementation is never shown fed by request data.",
      "field": "note",
      "dataType": "string",
      "required": true,
      "layers": ["backend"]
    },
    {
      "id": "VC-LAYER-SECURITY-UNVERIFIED-023",
      "description": "Declares the one structured security flag Stoa can check; the implementation is never shown fed by request data.",
      "field": "tag",
      "dataType": "string",
      "required": true,
      "security": {"serverSideValidation": true, "authenticationRequired": true, "ownershipRequired": true}
    },
    {
      "id": "VC-LAYER-FRONTEND-ONLY-024",
      "description": "Frontend-only claim; never checked by Stoa.",
      "field": "label",
      "dataType": "string",
      "required": true,
      "layers": ["frontend"]
    },
    {
      "id": "VC-OBJECT-FIELD-MATCH-025",
      "description": "Order SKU must be a non-empty string; z.object() field-by-field match.",
      "field": "sku",
      "dataType": "string",
      "required": true,
      "min": 1
    },
    {
      "id": "VC-OBJECT-FIELD-MISMATCH-026",
      "description": "Product price must be non-negative; z.object() field-by-field mismatch.",
      "field": "price",
      "dataType": "number",
      "required": true,
      "min": 0
    },
    {
      "id": "VC-OBJECT-FIELD-ABSENT-027",
      "description": "A field the contract names but the annotated object schema does not declare.",
      "field": "missingField",
      "dataType": "string",
      "required": true
    },
    {
      "id": "VC-OBJECT-FIELD-UNRESOLVED-028",
      "description": "A contract-named field whose own value uses .refine() — not a recognized scalar chain.",
      "field": "note",
      "dataType": "string",
      "required": true
    }
  ]
}
