{
  "name": "stoa",
  "version": "0.1.0",
  "description": "Stoic Code Analysis Engine – deterministic static analysis with a source-checked philosophical interpretation layer.",
  "type": "module",
  "license": "MIT",
  "author": "Stefan Werfling",
  "bin": {
    "stoa": "./dist/Cli.js"
  },
  "files": [
    "dist/",
    "schemas/",
    "knowledge/",
    "rules/"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "analyze": "tsx src/Cli.ts",
    "start": "node dist/Cli.js",
    "test": "node --import tsx --test test/*.test.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "@types/node": "^22.0.0",
    "@types/picomatch": "^4.0.3",
    "ajv": "^8.17.1",
    "eslint": "^9.13.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.11.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "php-parser": "^3.7.0",
    "picomatch": "^4.0.7",
    "tree-sitter-dart": "^1.0.0",
    "ts-morph": "^24.0.0",
    "web-tree-sitter": "^0.25.10"
  }
}
